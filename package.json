{
  "name": "octo-santa",
  "module": "src/mcp.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/mcp.ts",
    "repl": "bun run src/repl.ts",
    "build": "bun run build:mcp && bun run build:repl",
    "build:mcp": "bun build src/mcp.ts --outdir dist --target bun",
    "build:repl": "bun build src/repl.ts --compile --outfile dist/ocr"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  }
}
